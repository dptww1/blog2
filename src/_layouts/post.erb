---
layout: default
---

<h1><%= data.title %></h1>

<%= yield %>

<% if data.date %>
  <div class="post-date"><%= data.date.to_s[0..10] %></div>
<% end %>

<% if data.categories %>
  <div class="tags">
    Tags:
    <% data.categories.each_with_index do |tag,i| %>
      <a href='<%= relative_url "/categories/#{tag}"%>'><%= tag %></a><%= i < data.categories.size - 1 ? "," : ""%>
    <% end %>
  </div>
<% end %>
